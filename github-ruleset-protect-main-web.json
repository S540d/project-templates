{
  "name": "protect-main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "required_status_checks": [
          {
            "context": "code-quality"
          },
          {
            "context": "build-web"
          },
          {
            "context": "review-gate"
          }
        ],
        "strict_required_status_checks_policy": false
      }
    }
  ],
  "bypass_actors": []
}
